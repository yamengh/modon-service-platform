# Copy to .env.local (git-ignored) and set the address of the Modon backend AS SEEN FROM THE DEVICE.
# Only public, non-secret settings belong here: EXPO_PUBLIC_* values are bundled into the app.
#
#   Android emulator (backend on this PC):  http://10.0.2.2:5100
#   Physical phone on the same Wi-Fi:       http://<this PC's LAN IP>:5100   (start the backend with --launch-profile http-lan)
#   iOS simulator / tools on this PC:       http://127.0.0.1:5100
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5100
