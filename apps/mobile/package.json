{
  "name": "modon-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-localization": "~58.0.5",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "export:android": "expo export --platform android --output-dir dist",
    "export:ios": "expo export --platform ios --output-dir dist"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@portal/(.*)$": "<rootDir>/../portal/src/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup-after-env.ts"
    ],
    "testTimeout": 20000
  }
}
